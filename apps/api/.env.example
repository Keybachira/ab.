DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troca-isto-por-uma-chave-longa-e-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon. Pooled (host com -pooler) para a app; directo para migrações.
DATABASE_URL=postgresql://UTILIZADOR:PASSWORD@HOST-pooler.REGIAO.aws.neon.tech/NOME_DA_BD?sslmode=require
DATABASE_URL_DIRECT=postgresql://UTILIZADOR:PASSWORD@HOST.REGIAO.aws.neon.tech/NOME_DA_BD?sslmode=require

# Chave Fernet do cofre. Gerar com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
